<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moation.xscrape</string>

  <!-- Ticks every 15 minutes and almost always exits immediately. run.mjs owns
       the decision of whether one of the day's four random slots is due. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/scraper/run.mjs</string>
  </array>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>INGEST_URL</key>
    <string>https://moation.ai/api/ingest</string>
    <key>INGEST_KEY</key>
    <string>__INGEST_KEY__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Logs and the Chrome session live in ~/.config/moation, outside the repo. -->
  <key>StandardOutPath</key>
  <string>__HOME__/.config/moation/xscrape.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.config/moation/xscrape.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
